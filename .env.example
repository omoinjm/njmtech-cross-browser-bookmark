# .env — NOT committed (see .gitignore). Copy this file to .env and fill in
# real values. Used for local `wrangler` commands (deploy, d1 execute) via an
# API token instead of an interactive `wrangler login` session, which can
# expire. Same auth mechanism .github/workflows/deploy.yml uses in CI.
#
# Create a token at: Cloudflare dashboard → My Profile → API Tokens →
# Create Token → "Edit Cloudflare Workers" template (covers Workers Scripts,
# D1, and Workers Routes — everything `wrangler deploy` and the D1 migration
# commands need).
CLOUDFLARE_API_TOKEN=REPLACE_WITH_YOUR_API_TOKEN

# Optional — found in the Cloudflare dashboard sidebar on the Workers &
# Pages page. If omitted, it can be auto-detected via `wrangler whoami` as
# long as the token only has access to one account.
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_YOUR_ACCOUNT_ID
