{
  "manifest_version": 3,
  "name": "Bookmark Sync Engine",
  "version": "1.0.0",
  "description": "Automatically syncs new browser bookmarks to a personal Cloudflare-powered search & auto-tagging engine.",
  "permissions": [
    "bookmarks",
    "tabs",
    "storage",
    "notifications",
    "contextMenus"
  ],
  "host_permissions": [
    "https://bookmarks.njmtech.co.za/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "browser-polyfill.js",
      "config.js",
      "background.js"
    ]
  },
  "commands": {
    "save-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Save the current tab to the Library"
    }
  },
  "omnibox": {
    "keyword": "lib"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Bookmark Sync Engine",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bookmark-sync@njmtech.co.za",
      "strict_min_version": "109.0"
    }
  }
}
