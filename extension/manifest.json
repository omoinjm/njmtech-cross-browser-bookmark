{
  "manifest_version": 3,
  "name": "Azi",
  "version": "1.0.2",
  "description": "The browser extension that remembers so you don't have to. Syncs bookmarks to a personal Cloudflare-powered library with AI tagging and search.",
  "permissions": [
    "bookmarks",
    "tabs",
    "storage",
    "notifications",
    "contextMenus",
    "alarms"
  ],
  "host_permissions": [
    "https://api.bookmark.njmtech.co.za/*"
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": [
      "browser-polyfill.js",
      "config.js",
      "background.js"
    ]
  },
  "commands": {
    "save-current-tab": {
      "suggested_key": {
        "default": "Alt+Shift+W"
      },
      "description": "Save the current tab to the Library"
    }
  },
  "omnibox": {
    "keyword": "lib"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Azi",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "bookmark-sync@njmtech.co.za",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "authenticationInfo",
          "bookmarksInfo",
          "searchTerms",
          "websiteActivity",
          "websiteContent"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  }
}
