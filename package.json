{
  "name": "bookmark-sync-engine",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "db:init": "wrangler d1 execute bookmarks-db --file=./schema.sql",
    "db:init:remote": "wrangler d1 execute bookmarks-db --remote --file=./schema.sql"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^0.0.14",
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241127.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
